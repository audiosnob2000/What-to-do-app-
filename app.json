{
  "expo": {
    "name": "What To Do Nearby",
    "slug": "WhatToDoNearby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "whattodonearby",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whattodonearby.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EF",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.whattodonearby.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow What To Do Nearby to use your location to find events near you."
        }
      ]
    ]
  }
}
